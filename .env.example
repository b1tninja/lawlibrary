# Copy to .env. The process environment wins over this file.
# Leave LAWLIBRARY_DATA unset to use the platform directory:
#   Windows  %LOCALAPPDATA%\lawlibrary
#   macOS    ~/Library/Application Support/lawlibrary
#   other    $XDG_DATA_HOME/lawlibrary or ~/.local/share/lawlibrary
LAWLIBRARY_DATA=
