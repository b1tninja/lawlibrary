# Copy to .env here, or to ~/.lawlibrary/.env (the user config, read from any working directory;
# LAWLIBRARY_CONFIG names another file). The process environment wins, then this checkout's .env,
# then the user config. Write paths with forward slashes: D:/lawlibrary-data
# Leave LAWLIBRARY_DATA unset to use the default directory:
#   Windows  ~/.lawlibrary/data (not under AppData, which a packaged application's programs see redirected)
#   macOS    ~/Library/Application Support/lawlibrary
#   other    $XDG_DATA_HOME/lawlibrary or ~/.local/share/lawlibrary
LAWLIBRARY_DATA=
